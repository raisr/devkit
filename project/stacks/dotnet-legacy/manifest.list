# What the dotnet-legacy stack pack puts into a repository.
# See core/manifest.list for the format and the modes.
#
# A `+<pack>` line pulls another pack in first. The shared .NET rules are not
# selectable with --stack; this is how they arrive.

+shared/dotnet

AGENTS.dotnet-legacy.md|AGENTS.dotnet-legacy.md|managed

templates/gates.sh|.devkit/gates.sh|template
templates/Directory.Build.props|src/Directory.Build.props|template
templates/Architecture.Tests/Architecture.Tests.csproj|src/Tests/Architecture.Tests/Architecture.Tests.csproj|template
templates/Architecture.Tests/packages.config|src/Tests/Architecture.Tests/packages.config|template
templates/Architecture.Tests/Properties/AssemblyInfo.cs|src/Tests/Architecture.Tests/Properties/AssemblyInfo.cs|template
templates/Architecture.Tests/DomainExceptions.cs|src/Tests/Architecture.Tests/DomainExceptions.cs|template
templates/Architecture.Tests/LayoutTests.cs|src/Tests/Architecture.Tests/LayoutTests.cs|template
templates/Architecture.Tests/ProjectFile.cs|src/Tests/Architecture.Tests/ProjectFile.cs|template
templates/Architecture.Tests/ProjectLocation.cs|src/Tests/Architecture.Tests/ProjectLocation.cs|template
templates/Architecture.Tests/ReferenceTests.cs|src/Tests/Architecture.Tests/ReferenceTests.cs|template
templates/Architecture.Tests/SolutionTree.cs|src/Tests/Architecture.Tests/SolutionTree.cs|template
