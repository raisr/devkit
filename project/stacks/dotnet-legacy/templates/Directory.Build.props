<Project>

  <!-- MSBuild honours this file for old-style project files too, so the target
       and language version are set once here rather than in every .csproj.
       LangVersion is 7.3 because that is the highest version supported on
       .NET Framework - see dotnet-legacy.targets before raising it. -->
  <PropertyGroup>
    <Version>0.1.0</Version>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

</Project>
